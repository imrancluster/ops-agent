# One of: ollama | claude | openai (any OpenAI-compatible API)
LLM_PROVIDER=ollama
# Ollama: http://localhost:11434 on this Mac, or http://<Mac-1-IP>:11434 on the LAN
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:14b
# Ollama only: context window in tokens. Too small = old messages silently dropped.
LLM_NUM_CTX=16384

# Paid providers only. Leave empty for Ollama.
LLM_API_KEY=

# --- Optional backup provider (used only if the primary fails) -----------
# Leave BACKUP_PROVIDER empty to disable the fallback.
BACKUP_PROVIDER=
BACKUP_MODEL=claude-haiku-5-5
BACKUP_BASE_URL=
BACKUP_API_KEY=sk-ant-REPLACE_ME

# --- Example: run fully on a paid OpenAI-compatible API ------------------
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=<model-name>
# LLM_API_KEY=sk-REPLACE_ME